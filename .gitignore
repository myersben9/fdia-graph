__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.cache/
# large .npz operating-point pools ship as GitHub release assets, not committed to the repo
release_assets/
# local dataset shards + pools (ship as GitHub release ASSETS, never in git — ~1.2GB)
examples/release_v*/
# build / run artifacts
examples/*.out
examples/**/_log_*
examples/**/_run_*
examples/_log_*
examples/_run_*
examples/*.png
examples/fdia_dataset_report.pdf
examples/results/embeds_*.npz
examples/**/*.log
examples/**/*.out
examples/**/_tmp_*
examples/_tmp_*

# Development-only: experiment scripts, results, report/migration utilities (kept locally, not shipped)
examples/_*
examples/results/
examples/n1_outage/
examples/hpo_arma.py
examples/dataset_report.py
examples/reproduce_report.ipynb
examples/add_bus_attrs_v050.py
examples/upgrade_to_v050.py
examples/*.txt
# ...except the script that built the v0.8.0 timelines, the release's provenance
!examples/_build_timelines_v080.py
# never track dataset binaries (they live in GitHub releases)
*.h5
*.npz

# generated by scripts/site_index.py + mkdocs build
docs/index.md
docs/contributing.md
docs/changelog.md
site/

# per-method estimate/score caches written by the docs example scripts
docs/*/results/cache/

# the binaries the tests read: the v0.7.2 record shard (156 KB) and the frozen reference timeline
!tests/data/tiny_shard_v072.h5
!tests/frozen/tiny_ieee14_timeline.npz
