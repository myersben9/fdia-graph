__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.cache/
# large .npz operating-point pools ship as GitHub release assets, not committed to the repo
release_assets/
# local dataset shards + pools (ship as GitHub release ASSETS, never in git — ~1.2GB)
examples/release_v*/
# build / run artifacts
examples/*.out
examples/**/_log_*
examples/**/_run_*
examples/_log_*
examples/_run_*
examples/*.png
examples/fdia_dataset_report.pdf
examples/results/embeds_*.npz
examples/**/*.log
examples/**/*.out
examples/**/_tmp_*
examples/_tmp_*

# Development-only: experiment scripts, results, report/migration utilities (kept locally, not shipped)
examples/_*
examples/results/
examples/n1_outage/
examples/hpo_arma.py
examples/dataset_report.py
examples/reproduce_report.ipynb
examples/add_bus_attrs_v050.py
examples/upgrade_to_v050.py
examples/*.txt
# never track dataset binaries (they live in GitHub releases)
*.h5
*.npz

# generated by tools/site_index.py + mkdocs build
docs/index.md
docs/contributing.md
docs/changelog.md
site/

# the binaries the tests read: one frozen reference timeline per pinned data release
!tests/data/tiny_timeline_v080.h5
!tests/data/tiny_timeline_v081.h5
!tests/data/tiny_timeline_v083.h5
# the 2019 pool's frames of two days (6.7 MB), which the New York timeline digests build on
!tests/nygrid/data/days/*.h5

# the results store's write lock and partial writes
results/.lock
results/*.tmp
