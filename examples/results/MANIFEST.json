{
  "name": "ml-only-dangerous-attacks",
  "version": "0.3.0",
  "description": "ML-only dangerous FDIA localization dataset: realistic sparse PING-style measurement graphs, 7 attack families (3 stealthy/BDD-evading + 3 detectable + benign), IEEE-14/118/300.",
  "schema": {
    "format": "HDF5 (one file per system, chunked+gzip)",
    "graph": {
      "edge_index": "[2,E] from/to bus (lines then trafos)",
      "edge_reactance": "[E]"
    },
    "data": {
      "node_x": "[T,N,4] = [|V|(p.u.), P_inj(MW), Q_inj(MVAr), theta(deg)]",
      "node_m": "[T,N,4] availability mask (which node measurements exist)",
      "edge_x": "[T,E,2] = [P_from(MW), Q_from(MVAr)] on lines+trafos",
      "edge_m": "[T,E,2] availability mask",
      "y": "[T,N] per-bus attack label (multi-label localization target)",
      "family": "[T] 0benign 1Ao 2Ad 3As 4Ar 5ramp 6LRA",
      "stealthy": "[T] 1 if the attack evades classical bad-data detection",
      "split": "[T] 0train 1val 2test (chronological 60/20/20, seq-boundary safe)",
      "seq_id": "[T] ramp-sequence id (>=0) else -1",
      "timestep": "[T] source operating-point index",
      "gap": "[T] 1 if a physics non-convergence NA row (\u22480 here)"
    }
  },
  "families": {
    "stealthy_ML_only": {
      "Ao": "state-consistent load redistribution",
      "ramp": "temporal creeping redistribution over multi-timestep sequences (ramp attack of Haghshenas, Hasnat & Naeini, IEEE ISGT 2023)",
      "LRA": "targeted masked-overload (Yuan, Li & Ren, IEEE T-SG 2011)"
    },
    "detectable_contrast": {
      "Ad": "random meter corruption",
      "As": "meter scaling",
      "Ar": "replay"
    }
  },
  "protocol": {
    "split": "60/20/20 chronological, cut on sequence boundaries (ramp seqs never straddle)",
    "class_balance": "equal per attack family (~3k/system), constant across systems",
    "heldout_generalization": "unseen-attack: As & Ar reserved for test-only (train/val exclude them)",
    "metrics": "report per-attack-type node-F1 (not accuracy); stealthy families are the hard ones"
  },
  "measurement_model": "sparse SCADA/PMU graph, redundancy ~2-3 (PING: Zaman & Lin, NAPS 2025; PIHAN).",
  "references": [
    "Yuan, Li & Ren, 'Modeling load redistribution attacks in power systems', IEEE T-SG 2(2), 2011",
    "Haghshenas, Hasnat & Naeini, 'A Temporal Graph Neural Network for Cyber Attack Detection and Localization in Smart Grids', IEEE ISGT 2023 (source of the ramp attack)",
    "Zaman & Lin, 'PING: Physics-Informed GNNs to Generalize FDIA Localization', NAPS 2025",
    "Boyaci et al., 'Joint Detection and Localization of Stealth FDIA', IEEE Trans. Smart Grid, 2022"
  ],
  "seed": 123,
  "systems": {
    "ieee14": {
      "system": 14,
      "n_buses": 14,
      "n_branches": 20,
      "n_records": 38000,
      "lra_target_line": 5,
      "size_mb": 15.9,
      "file": "ml_only_ieee14.h5",
      "families": {
        "benign": {
